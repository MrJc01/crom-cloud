{
  "slug": "{{PLUGIN_SLUG}}",
  "name": "{{PLUGIN_NAME}}",
  "version": "0.1.0",
  "description": "Plugin {{PLUGIN_NAME}} (multi-linguagem) para Crom Cloud",
  "icon": "🌐",
  "status": "active",
  "runtime": {
    "binary": "{{PLUGIN_SLUG}}",
    "language": "{{PLUGIN_LANG}}",
    "script_entry": "scripts/main.{{PLUGIN_EXT}}",
    "health_check_interval": "30s"
  },
  "billing": {
    "model": "per_call",
    "credit_cost": 1,
    "premium_actions": {}
  },
  "required_secrets": [],
  "api_routes": [
    {
      "method": "GET",
      "path": "/ping",
      "description": "Health check simples",
      "scope": "read"
    },
    {
      "method": "POST",
      "path": "/execute",
      "description": "Ação principal do plugin",
      "scope": "write"
    }
  ]
}
