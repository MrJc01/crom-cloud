.PHONY: build clean test install-deps

BINARY={{PLUGIN_SLUG}}

build:
	go build -o $(BINARY) .

clean:
	rm -f $(BINARY)

test:
	go test ./... -v

install-deps:
	@echo "Instalando dependências do script..."
	@if [ -f scripts/requirements.txt ]; then pip3 install -r scripts/requirements.txt; fi
	@if [ -f scripts/package.json ]; then cd scripts && npm install; fi
